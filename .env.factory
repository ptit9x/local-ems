# ============================================
# Local EMS — Factory Environment Variables
# ============================================
# Copy to .env and adjust values for your factory.
# Priority: ENV vars > .env > YAML > defaults

# --- Core ---
EMS_SIMULATE=true
EMS_UI_PORT=8080
EMS_UI_PASSWORD=factory@2025
EMS_DB_DSN=data/ems-factory.db
EMS_RETENTION_DAYS=90

# --- Controllers ---
EMS_PEAK_THRESHOLD_W=250000        # 250kW — below 300kW contract
EMS_TOU_MAX_CHARGE_W=500000        # 500kW charge (5MWh BESS)
EMS_TOU_MAX_DISCHARGE_W=500000     # 500kW discharge
EMS_TOU_MIN_SOC=15.0
EMS_FORCE_CHARGE_W=50000           # 50kW force charge
EMS_MIN_SOC=15.0
EMS_FORCE_CHARGE_SOC=10.0
EMS_EV_ENABLED=true                # factory has EV chargers
EMS_EV_MAX_SITE_POWER_W=150000     # 150kW EV budget

# --- Simulator (match factory scale) ---
EMS_SIM_SOLAR_PEAK_W=800000        # 800kWp solar array
EMS_SIM_LOAD_BASE_W=300000         # 300kW factory load
EMS_SIM_LOAD_VARIANCE_W=100000     # ±50kW (machines on/off)
EMS_SIM_BATTERY_CAPACITY_WH=5000000 # 5MWh
EMS_SIM_MAX_CHARGE_W=500000        # 500kW
EMS_SIM_MAX_DISCHARGE_W=500000     # 500kW
