# ============================================
# Local EMS — Smart Home Environment Variables
# ============================================
# Copy to .env and adjust values for your home.
# Priority: ENV vars > .env > YAML > defaults

# --- Core ---
EMS_SIMULATE=true
EMS_UI_PORT=8080
EMS_UI_PASSWORD=home@2025
EMS_DB_DSN=data/ems-home.db
EMS_RETENTION_DAYS=30

# --- Controllers ---
EMS_PEAK_THRESHOLD_W=3000          # 3kW — typical home peak
EMS_TOU_MAX_CHARGE_W=2000          # 2kW charge (10kWh battery)
EMS_TOU_MAX_DISCHARGE_W=3000       # 3kW discharge
EMS_TOU_MIN_SOC=20.0
EMS_FORCE_CHARGE_W=2000            # 2kW force charge
EMS_EV_ENABLED=false               # no EV charger at home
EMS_EV_MAX_SITE_POWER_W=5000

# --- Simulator (match home scale) ---
EMS_SIM_SOLAR_PEAK_W=4500          # 4.5kWp rooftop
EMS_SIM_LOAD_BASE_W=1500           # 1.5kW base load
EMS_SIM_LOAD_VARIANCE_W=1000       # ±500W variance
EMS_SIM_BATTERY_CAPACITY_WH=10000  # 10kWh battery
EMS_SIM_MAX_CHARGE_W=3000          # 3kW max
EMS_SIM_MAX_DISCHARGE_W=5000       # 5kW max
