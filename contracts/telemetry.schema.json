{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vmo/ems-platform/contracts/telemetry",
  "title": "TelemetryMessage",
  "description": "Aggregated telemetry data sent from Local EMS to Cloud every sync interval (default 5 minutes) via MQTT.",
  "type": "object",
  "required": ["schema_version", "message_id", "site_id", "timestamp", "interval_sec", "cycle_count"],
  "properties": {
    "schema_version": { "const": 1 },
    "message_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "site_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "description": "Unique site identifier, e.g. 'sg-01'"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Start of the aggregation window (UTC, RFC3339)"
    },
    "interval_sec": {
      "type": "integer",
      "minimum": 1,
      "description": "Duration of the aggregation window in seconds"
    },
    "avg_solar_w": {
      "type": "integer",
      "description": "Average solar power generation in watts (positive = generating)"
    },
    "avg_load_w": {
      "type": "integer",
      "description": "Average building load in watts (positive = consuming)"
    },
    "avg_grid_w": {
      "type": "integer",
      "description": "Average grid power in watts (positive = importing, negative = exporting)"
    },
    "avg_ess_w": {
      "type": "integer",
      "description": "Average ESS power in watts (positive = discharge, negative = charge)"
    },
    "min_soc": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Minimum battery SOC during window (%)"
    },
    "max_soc": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Maximum battery SOC during window (%)"
    },
    "avg_soc": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Average battery SOC during window (%)"
    },
    "max_temp_c": {
      "type": "number",
      "description": "Maximum battery temperature during window (°C)"
    },
    "energy_charge_wh": {
      "type": "integer",
      "description": "Total energy charged during window (Wh)"
    },
    "energy_discharge_wh": {
      "type": "integer",
      "description": "Total energy discharged during window (Wh)"
    },
    "cycle_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of 1-second control cycles in this window"
    },
    "alerts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Alert messages generated during window (optional)"
    }
  },
  "additionalProperties": false
}
