%% CDI EMS Phase 2 target architecture. This file is the source of truth.
flowchart LR
    classDef hw fill:#172033,stroke:#64748b,color:#f8fafc
    classDef edge fill:#0f2942,stroke:#38bdf8,color:#f8fafc
    classDef control fill:#302710,stroke:#facc15,color:#fef08a
    classDef data fill:#28163d,stroke:#c084fc,color:#f3e8ff
    classDef cloud fill:#102d29,stroke:#34d399,color:#f8fafc
    classDef external fill:#3b1d24,stroke:#fb7185,color:#fff1f2
    classDef note fill:#202020,stroke:#94a3b8,color:#f8fafc,stroke-dasharray: 5 5

    subgraph SITE["SITE HARDWARE — SINGAPORE"]
      direction TB
      PM["Power Meter ×3<br/>PCC / Solar / Load"]:::hw
      BMS["BMS ×4<br/>SOC • SOH • Temperature • Fire"]:::hw
      PCS["PCS ×24 — Lite-On<br/>Active / Reactive Power"]:::hw
      SWITCH["Industrial Ethernet Switch<br/>Site LAN"]:::hw
      EV["EV Charger ×6<br/>OCPP 1.6J"]:::hw
      PM <-->|"Modbus TCP • telemetry"| SWITCH
      BMS -->|"Modbus TCP • telemetry<br/>vendor CAN remains internal"| SWITCH
      PCS <-->|"Modbus TCP • telemetry + command"| SWITCH
      EV <-->|"OCPP WebSocket"| SWITCH
    end

    subgraph EDGE["LOCAL EMS — GO • ON-PREMISE EDGE"]
      direction TB
      subgraph ADAPTER_LAYER["CONFIG-DRIVEN ADAPTER LAYER"]
        direction TB
        FACTORY["AdapterFactory + DeviceRegistry<br/>Select by type • protocol • vendor profile"]:::edge
        METER_BMS["Meter + BMS Adapters<br/>Modbus TCP"]:::edge
        PCS_ADAPTER["PCS Driver Adapter<br/>Built-in / YAML vendor profile"]:::edge
        EV_ADAPTER["EV Adapter<br/>Modbus TCP or OCPP 1.6J"]:::edge
        NORMALIZED["Normalized Snapshot + Health<br/>Registry runtime orchestration implemented"]:::edge
        FACTORY --> METER_BMS
        FACTORY --> PCS_ADAPTER
        FACTORY --> EV_ADAPTER
        METER_BMS --> NORMALIZED
        PCS_ADAPTER --> NORMALIZED
        EV_ADAPTER --> NORMALIZED
      end
      OCPP_LOCAL["Local OCPP Central System<br/>Primary EV control endpoint"]:::edge
      DAQ["Data Acquisition + In-Memory State<br/>200 ms critical • 5 s standard"]:::edge
      subgraph ENGINE["Constraint Control Engine — 1 s autonomous loop"]
        direction TB
        P1["P1 Battery / Fire Protection"]:::control
        P2["P2 Grid Compliance"]:::control
        P3["P3 Peak Shaving • ToU • EV DLM"]:::control
        P4["P4 Self-Consumption • Validated Cloud Setpoints"]:::control
        P1 --> P2 --> P3 --> P4
      end
      DIST["Command Distributor<br/>PCS setpoints • EV fair-share limits"]:::edge
      WATCH["Hardware Watchdog + Device Health"]:::edge
      FAIL_LOCAL["Local Failover Agent<br/>lease_epoch • control owner • handover"]:::edge
      CONFIG["Hot-Reload Config Manager<br/>validate • atomic apply • rollback"]:::edge
      SQLITE[("SQLite WAL<br/>7-day buffer • config revision • audit")]:::data
      SYNC["MQTT Store-and-Forward<br/>QoS 1 • rate-limited backfill"]:::edge
      LOCAL_UI["Local Dashboard + Manual Override<br/>:8080"]:::edge
      NORMALIZED --> DAQ --> ENGINE --> DIST
      DIST --> WATCH --> FACTORY
      OCPP_LOCAL <--> EV_ADAPTER
      DIST --> OCPP_LOCAL
      FAIL_LOCAL -. "control gate" .-> DIST
      CONFIG --> FACTORY
      CONFIG --> ENGINE
      DAQ --> SQLITE
      DIST --> SQLITE
      SQLITE <--> SYNC
      SQLITE --> LOCAL_UI
    end

    SWITCH <-->|"Modbus TCP"| METER_BMS
    SWITCH <-->|"Modbus TCP"| PCS_ADAPTER
    SWITCH <-->|"Modbus TCP — optional EV profile"| EV_ADAPTER
    SWITCH <-->|"Primary OCPP 1.6J"| OCPP_LOCAL

    subgraph BOUNDARY["SITE FIREWALL / NAT / TLS BOUNDARY"]
      FW["Outbound TLS allowlist<br/>MQTT 8883 • OCPP WSS"]:::external
    end

    subgraph CLOUD["EMS CLOUD — MULTI-TENANT PLATFORM"]
      direction TB
      MQTT["MQTT Broker<br/>TLS • QoS 1 • per-site credentials"]:::cloud
      INGEST["Telemetry + Heartbeat Ingestion<br/>deduplication • offline detector"]:::cloud
      API["NestJS API<br/>RBAC • tenant isolation • audit"]:::cloud
      DB[("PostgreSQL / TimescaleDB<br/>telemetry • EV sessions • failover • config")]:::data
      OCPP_CLOUD["Cloud OCPP Central System<br/>Backup charger registry"]:::cloud
      FAIL_CLOUD["EV Failover Controller<br/>lease coordinator • safe mode"]:::cloud
      COMMAND["Command + Configuration Service<br/>tariff • topology • revision deployment"]:::cloud
      FDD["FDD + Alert Rule Engine<br/>debounce • cooldown • acknowledge"]:::cloud
      NOTIFY["Notification Adapters<br/>Email • SMS • Webhook"]:::cloud
      DASH["React Operations Dashboard<br/>fleet • EV • failover • alerts • config"]:::cloud
      OBS["Metrics + Operations Audit<br/>health • latency • takeover duration"]:::cloud
      MQTT --> INGEST --> API
      API <--> DB
      COMMAND --> MQTT
      FAIL_CLOUD <--> OCPP_CLOUD
      FAIL_CLOUD --> DB
      INGEST --> FAIL_CLOUD
      API --> FDD --> NOTIFY
      FDD --> DB
      API <--> DASH
      OBS -.-> DASH
      MQTT -.-> OBS
      OCPP_CLOUD -.-> OBS
    end

    SYNC ==>|"Telemetry • heartbeat v2 • command ACK<br/>5-min aggregate + backfill"| FW
    FW ==>|"MQTT TLS"| MQTT
    MQTT -.->|"Config • tariff • validated setpoints"| SYNC
    FAIL_CLOUD <-->|"takeover • recovery • ACK<br/>lease_epoch"| FAIL_LOCAL
    SWITCH <-.->|"Backup OCPP 1.6J — Phase 2<br/>logical path; vendor capability gate"| FW
    FW <-.->|"OCPP WSS safe-mode commands<br/>only while Cloud owns lease"| OCPP_CLOUD

    AUTONOMY["LOCAL AUTONOMY<br/>BESS safety and control continue<br/>when Cloud or MQTT is unavailable"]:::note
    VENDOR["EXTERNAL GATE<br/>Confirm charger dual endpoint, DNS/LB<br/>or redundant site gateway before SAT"]:::note
    ENGINE -.-> AUTONOMY
    OCPP_CLOUD -.-> VENDOR
