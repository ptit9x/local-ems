# ─── EMS Cloud — Environment Variables ───
# Copy to .env and fill in values

# ─── Database ───
DATABASE_URL="postgresql://ems:ems_secret@localhost:5432/ems_cloud?schema=public"

# ─── MQTT ───
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_CLIENT_ID="ems-cloud-api"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_TOPIC_PREFIX="ems"

# ─── API ───
API_PORT=3000
API_PREFIX="api"
NODE_ENV="development"

# ─── Auth (Phase B3) ───
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="24h"

# ─── Docker Compose ───
POSTGRES_USER=ems
POSTGRES_PASSWORD=ems_secret
POSTGRES_DB=ems_cloud
MOSQUITTO_PORT=1883
