FROM node:26-alpine AS build
WORKDIR /app
COPY package*.json ./
COPY apps/ems-web/package.json apps/ems-web/package.json
COPY apps/ems-api/package.json apps/ems-api/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci
COPY apps/ems-web apps/ems-web
RUN npm run build -w apps/ems-web
FROM nginx:1.27-alpine
COPY --from=build /app/apps/ems-web/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
