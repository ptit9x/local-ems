{
  "name": "ems-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "EMS Cloud Platform — Multi-tenant fleet management",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/ems-api",
    "dev:web": "npm run dev -w apps/ems-web",
    "build": "npm run build -w packages/shared && npm run build -w apps/ems-api && npm run build -w apps/ems-web",
    "test": "npm run test -w apps/ems-api",
    "lint": "npm run lint -w apps/ems-api",
    "test:contracts": "node scripts/validate-contracts.cjs",
    "test:smoke": "node scripts/smoke-demo.mjs",
    "db:generate": "npm run db:generate -w apps/ems-api",
    "db:migrate": "npm run db:migrate -w apps/ems-api",
    "db:seed": "npm run db:seed -w apps/ems-api",
    "db:studio": "npm run db:studio -w apps/ems-api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "overrides": {
    "body-parser": "^2.3.0",
    "multer": "^2.4.0",
    "qs": "^6.16.1",
    "lodash": "^4.18.1",
    "deepmerge-ts": "8.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
